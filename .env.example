# ── 服务 ───────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── 数据库 ─────────────────────────────────────────────────────
# Docker 内默认 /app/data/proxy_pool.db，通过 volume 挂载持久化
DB_PATH=data/proxy_pool.db

# ── 调度器（Dockerfile 默认开启）────────────────────────────────
SCHEDULER_ENABLED=true
FETCH_INTERVAL_SECONDS=1800
VALIDATE_INTERVAL_SECONDS=600
VALIDATE_BATCH_SIZE=100
VALIDATE_CONCURRENCY=50
VALIDATE_TIMEOUT_SECONDS=10

# ── 代理源 ─────────────────────────────────────────────────────
PROVIDER_URL_LISTS_ENABLED=false
PROVIDER_URL_LIST_URLS=[]
PROVIDER_CONFIG_FILE=config/providers.yaml

# ── 鉴权（局域网访问保持 false）─────────────────────────────────
AUTH_ENABLED=false
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD=
AUTH_SESSION_SECURE=false

# ── 日志 ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── 可选功能 ───────────────────────────────────────────────────
METRICS_ENABLED=true
GATEWAY_ENABLED=false
GEO_ENABLED=false
