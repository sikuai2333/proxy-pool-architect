APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
AUTH_ENABLED=false
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD=
AUTH_SESSION_TTL_SECONDS=43200
AUTH_SESSION_COOKIE_NAME=proxy_pool_session
AUTH_SESSION_SECURE=false
AUTH_SESSION_SAMESITE=lax
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true
ALLOWED_HOSTS=[]
GZIP_MINIMUM_SIZE=1024
LOG_LEVEL=INFO
LOG_JSON=false
REDIS_URL=redis://localhost:6379/0
PROXY_LIST_CACHE_TTL_SECONDS=10
PROVIDER_STATIC_ENABLED=true
PROVIDER_STATIC_PROXIES=[]
PROVIDER_URL_LISTS_ENABLED=false
PROVIDER_URL_LIST_URLS=[]
PROVIDER_URL_TIMEOUT_SECONDS=10
PROVIDER_URL_CONCURRENCY=5
PROVIDER_CONFIG_FILE=config/providers.yaml
PROVIDER_PLUGIN_ALLOWED_PREFIXES=["app.providers."]
GEO_ENABLED=false
GEO_FILE=config/geo.csv
VALIDATE_CONCURRENCY=100
VALIDATE_TIMEOUT_SECONDS=10
TEST_URL=https://httpbin.org/ip
ANONYMITY_TEST_URL=https://httpbin.org/headers
VALIDATOR_ORIGINAL_IP=
MIN_ELITE_SCORE=80
COOLDOWN_SECONDS=1800
SESSION_AFFINITY_TTL_SECONDS=3600
SCHEDULER_ENABLED=false
FETCH_INTERVAL_SECONDS=1800
VALIDATE_INTERVAL_SECONDS=600
VALIDATE_BATCH_SIZE=100
METRICS_ENABLED=true
RUNTIME_EVENT_LIMIT=500
RUNTIME_VALIDATION_JOB_LIMIT=200
RUNTIME_EVENT_RETENTION_SECONDS=86400
RUNTIME_VALIDATION_JOB_RETENTION_SECONDS=604800
