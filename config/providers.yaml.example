providers:
  - type: static
    enabled: true
    options:
      proxies:
        - "http://127.0.0.1:8080"

  - type: url_list
    enabled: false
    options:
      urls:
        - "https://example.com/proxies.txt"
      timeout_seconds: 10
      concurrency: 5

  - type: clash_subscription
    enabled: false
    options:
      urls: []
      files:
        - "config/clash-subscription.yaml"
      timeout_seconds: 10
      concurrency: 3

  - type: tor
    enabled: false
    options:
      socks_host: "127.0.0.1"
      socks_port: 9050

  # Starts or connects to a local adapter core such as Clash/Mihomo/sing-box.
  # The core handles node protocols and exposes a local HTTP/SOCKS inbound.
  - type: core_adapter
    enabled: false
    options:
      core_name: "mihomo"
      command: ["mihomo", "-f", "config/mihomo.yaml"]
      config_file: "config/mihomo.yaml"
      local_host: "127.0.0.1"
      # If local_scheme/local_port are omitted, mixed-port, socks-port, then port
      # are inferred from config_file.
      local_scheme: "http"
      local_port: 7890
      readiness_url: "http://127.0.0.1:9090/version"
      startup_timeout_seconds: 10
      shutdown_on_exit: true

  # Custom providers must be trusted code. By default, only app.providers.* is allowed.
  - type: custom
    enabled: false
    class_path: "app.providers.static_provider.StaticProvider"
    options:
      proxies: []
